# Copiez ce fichier en .env.local et remplissez avec vos clés Supabase
# (Project Settings > API dans votre projet Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Uniquement côté serveur, ne jamais exposer côté client
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# URL publique du site (utilisée pour les redirections Stripe Checkout)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (envoi des e-mails de confirmation/notification de rendez-vous)
# https://resend.com/api-keys
RESEND_API_KEY=votre-cle-resend

# Stripe (abonnements + pay-per-lead) — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=votre-cle-secrete-stripe
STRIPE_WEBHOOK_SECRET=votre-secret-webhook-stripe
# Price ID des 3 paliers d'abonnement, créés dans le dashboard Stripe
# (Product catalog > Add product > Recurring)
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_BUSINESS=price_xxx
